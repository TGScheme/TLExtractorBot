import "changelog_story"
import "scheme_changes"
import "objects_difference"
import "fields_difference"
import "object_linked"
import "os_utils"

<figure><img src="{{banner_url}}"></figure>
{%- if story %}
{{ getChangelogStory(story) }}
<aside>This article and the short descriptions below were generated by <code>{{ ai_model }}</code> from the schema diff. The schema is extracted directly from the app. If the text and the schema disagree, rely on the schema.</aside>
<hr>
{% endif -%}
{%- if latest %}
<h3>New in this build</h3>
{%- if latest_source %}
<p><i>{{ osName(latest_source.Source) }} {{ osVersion(latest_source.Source, latest_source.VersionName, latest_source.BuildNumber) }}</i></p>
{%- endif %}
{%- if latest_stats.MainApi.Total > 0 %}
{{ getObjectsDifference("Methods", latest_stats.MainApi.Methods, latest.MainApi.MethodsDifference) }}
{{ getObjectsDifference("Constructors", latest_stats.MainApi.Constructors, latest.MainApi.ConstructorsDifference) }}
{%- endif %}
{%- if latest_stats.E2EApi.Total > 0 %}
{{ getObjectsDifference("End-to-end Methods", latest_stats.E2EApi.Methods, latest.E2EApi.MethodsDifference) }}
{{ getObjectsDifference("End-to-end Constructors", latest_stats.E2EApi.Constructors, latest.E2EApi.ConstructorsDifference) }}
{%- endif %}
<hr>
{% endif -%}
{%- if stats.MainApi.Total > 0 -%}
{{ getSchemeChanges(differences.MainApi, stats.MainApi, true) }}
<h4>Schema</h4>
<pre>{{ main_scheme }}</pre>
{%- endif %}
{% if stats.E2EApi.Total > 0 -%}
{{ getSchemeChanges(differences.E2EApi, stats.E2EApi, false) }}
<h4>End-to-end schema</h4>
<pre>{{ e2e_scheme }}</pre>
{%- endif -%}
