import "changelog_story"
import "scheme_changes"
import "objects_difference"
import "fields_difference"
import "object_linked"
import "os_utils"

<figure><img src="{{banner_url}}"></figure>
<p><i>Layer {{ layer }} · {{ osFull(update) }} · {% if is_stable %}Stable{% else %}Preview{% endif %}</i></p>
{%- if story %}
{{ getChangelogStory(story) }}
<hr>
{%- elif is_draft %}
<aside>⏳ The full changelog is still being written. Meanwhile, here are the technical changes straight from the schema. This page will update on its own as soon as it's ready.</aside>
<hr>
{% endif -%}
{%- if latest and (latest_stats.MainApi.Total > 0 or latest_stats.E2EApi.Total > 0) %}
<h3>Changes in {{ osFull(latest_source) }}</h3>
<p><i>Compared with the previous build</i></p>
{%- if latest_stats.MainApi.Total > 0 %}
{{ getObjectsDifference("Methods", latest_stats.MainApi.Methods, latest.MainApi.MethodsDifference) }}
{{ getObjectsDifference("Constructors", latest_stats.MainApi.Constructors, latest.MainApi.ConstructorsDifference) }}
{%- endif %}
{%- if latest_stats.E2EApi.Total > 0 %}
{{ getObjectsDifference("End-to-end Methods", latest_stats.E2EApi.Methods, latest.E2EApi.MethodsDifference) }}
{{ getObjectsDifference("End-to-end Constructors", latest_stats.E2EApi.Constructors, latest.E2EApi.ConstructorsDifference) }}
{%- endif %}
<hr>
{% endif -%}
{%- if stats.MainApi.Total > 0 -%}
{{ getSchemeChanges(differences.MainApi, stats.MainApi, true, layer, previous_layer) }}
<h4>Schema</h4>
<pre>{{ main_scheme }}</pre>
{%- endif %}
{% if stats.E2EApi.Total > 0 -%}
{{ getSchemeChanges(differences.E2EApi, stats.E2EApi, false, layer, previous_layer) }}
<h4>End-to-end Schema</h4>
<pre>{{ e2e_scheme }}</pre>
{%- endif -%}
{%- if story or support_url %}
<hr>
{%- endif %}
{%- if story %}
<p><i>Summary and descriptions written by {{ ai_model }} from the schema diff. If they ever disagree with the schema, trust the schema.</i></p>
{%- endif %}
{%- if support_url %}
<p><i>If these changelogs save you time, you can <a href="{{ support_url }}">support the channel ☕</a></i></p>
{%- endif %}
