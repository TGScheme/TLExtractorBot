{% macro getRichChanges(changes, summary) -%}
<blockquote expandable><b>{{ summary }}</b>
{%- for change in changes -%}
{%- if forloop.Counter <= 15 -%}
<br>• {% if change.Object.IsNew -%}
Added {{ objectLinked(change.Object) }}
{%- elif change.Object.IsDeleted -%}
Removed {{ objectLinked(change.Object) }}
{%- elif change.Object.ChangedResult -%}
Changed type of {{ objectLinked(change.Object) }} from <b>{{ change.Object.ChangedResult.OldType }}</b> to <b>{{ change.Object.ChangedResult.NewType }}</b>
{%- else -%}
{{ getFieldsDifference(change.Object) | capfirst | safe }} in {{ objectLinked(change.Object) }}
{%- endif -%}
{%- if change.IsE2E %} <i>(secret chats)</i>{% endif -%}
{%- endif -%}
{%- endfor -%}
{%- if changes | length > 15 -%}
<br>And {{ (changes | length) - 15 }} more in the full changelog.
{%- endif -%}
</blockquote>
{%- endmacro %}
