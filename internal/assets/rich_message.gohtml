import "objects_difference"
import "fields_difference"
import "object_linked"
import "os_utils"

<h3>Layer {{ layer }}</h3>
<p><i>{{ osName(update.Source) }} {{ osVersion(update.Source, update.VersionName, update.BuildNumber) }} · {% if is_stable %}Stable{% else %}Preview{% endif %}{% if is_patch %} · Patch{% endif %}</i></p>
{%- if lead %}
<p>{{ lead | safe }}</p>
{%- endif %}
<table>
<tr><th>Schema</th><th>New</th><th>Changed</th><th>Deleted</th></tr>
{%- if stats.MainApi.Total > 0 %}
<tr><td>Main</td><td>{{ stats.MainApi.TotalAdditions }}</td><td>{{ stats.MainApi.TotalChanges }}</td><td>{{ stats.MainApi.TotalDeletions }}</td></tr>
{%- endif %}
{%- if stats.E2EApi.Total > 0 %}
<tr><td>End-to-end</td><td>{{ stats.E2EApi.TotalAdditions }}</td><td>{{ stats.E2EApi.TotalChanges }}</td><td>{{ stats.E2EApi.TotalDeletions }}</td></tr>
{%- endif %}
</table>
{%- if detailed %}
<details open>
<summary>What changed</summary>
{%- if stats.MainApi.Total > 0 %}
{{ getObjectsDifference("Methods", stats.MainApi.Methods, differences.MainApi.MethodsDifference) }}
{{ getObjectsDifference("Constructors", stats.MainApi.Constructors, differences.MainApi.ConstructorsDifference) }}
{%- endif %}
{%- if stats.E2EApi.Total > 0 %}
{{ getObjectsDifference("End-to-end Methods", stats.E2EApi.Methods, differences.E2EApi.MethodsDifference) }}
{{ getObjectsDifference("End-to-end Constructors", stats.E2EApi.Constructors, differences.E2EApi.ConstructorsDifference) }}
{%- endif %}
</details>
{%- endif %}
<footer>#{{ osShortName(update.Source) }} #{% if is_stable %}Stable{% else %}Preview{% endif %} #Layer{{ layer }}{% if is_patch %} #Patch{% endif %}</footer>
