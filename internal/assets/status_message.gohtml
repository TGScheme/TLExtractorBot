import "os_utils"

{% macro step(stage, at, text) -%}
<li>{% if stage == at %}<b>{{ text }}</b>{% else %}{{ text }}{% endif %}</li>
{%- endmacro %}

{% macro stepProgress(stage, at, doing, done, progress) -%}
<li>{% if stage == at %}<b>{{ doing }} {{ progress }}%</b>{% else %}{{ done }}{% endif %}</li>
{%- endmacro %}

<h3>{{ osFull(update) }}</h3>
<p><i>{% if is_patch %}Patching{% else %}Extracting{% endif %} the TL-schema</i></p>
<ul>
{% if update.Source == "android" %}
{{ stepProgress(stage, 0, "Downloading the apk…", "Downloaded the apk", progress) }}
{{ stepProgress(stage, 1, "Decompiling…", "Decompiling the apk", progress) }}
{% else %}
<li>Fetched the source</li>
{% endif %}
{{ step(stage, 2, "Extracting the schema") }}
{{ step(stage, 3, "Publishing the changelog") }}
</ul>
<footer>This message will be replaced by the changelog.</footer>
