{% macro getObjectsDifference(name, schemeStats, objsDiff) %}
{% if schemeStats.Additions > 0 -%}
<h4>New {{ name }}</h4>
<ul>
{% for obj in objsDiff -%}
{%- if obj.IsNew %}
    <li>{{ objectLinked(obj) }}{% if gemini_descriptions[obj.Object.Package] %} — {{ gemini_descriptions[obj.Object.Package] | safe }}{% endif %}</li>
{% endif -%}
{%- endfor %}
</ul>
{% endif %}
{% if schemeStats.Changes > 0 -%}
<h4>Changed {{ name }}</h4>
<ul>
{% for obj in objsDiff -%}
{%- if !obj.IsNew && !obj.IsDeleted %}
    {%- if obj.NewFields | length > 0 || obj.RemovedFields | length > 0 || obj.ChangedFields | length > 0 %}
    <li>{{ objectLinked(obj) }}: {{ getFieldsDifference(obj) | safe }}</li>
    {%- endif %}
    {%- if obj.ChangedResult %}
    <li>{{ objectLinked(obj) }}: type changed from <b>{{ obj.ChangedResult.OldType }}</b> to <b>{{ obj.ChangedResult.NewType }}</b></li>
    {%- endif %}
{% endif -%}
{%- endfor %}
</ul>
{%- endif -%}
{% if schemeStats.Deletions > 0 -%}
<h4>Removed {{ name }}</h4>
<ul>
{% for obj in objsDiff -%}
{%- if obj.IsDeleted %}
    <li>{{ objectLinked(obj) }}</li>
{% endif -%}
{%- endfor %}
</ul>
{%- endif -%}
{% endmacro %}